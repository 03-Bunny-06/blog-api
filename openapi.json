    "/admin/signup": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "SignUp",
        "description": "SignUp",
        "operationId": "signup",
        "parameters": [
          {
            "name": "username",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "admin2"
            }
          },
          {
            "name": "password",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "ADMIN1234"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Admin created successfully!!!"
          },
          "400": {
            "description": "Bad Request - Admin already exists try SignIn instead!!!" 
          }
        }
      }
    },
