    "/admin/create-blog": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Create Blog",
        "description": "Create Blog",
        "operationId": "createBlog",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/admin_createblog_body"
              },
              "examples": {
                "Create Blog": {
                  "value": {
                    "description": "Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s.",
                    "imageLink": "https://media.geeksforgeeks.org/wp-content/uploads/20240415204701/How-to-Become-a-Python-Full-Stack-Developer.png",
                    "title": "Does Aliens really exist ?",
                    "topic": "science"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": {
                            "statusText": "OK",
                            "msg": "Blog created successfully!!!"
                           }
                },
          "400": {
            "description": {
                            "statusText": "Bad Requset",
                            "msg": "Invalid Inputs",
                            "error": "invalid signature"
                           }
                },
          "401": {
            "description": {
                            "statusText": "Unauthorized",
                            "msg": "Authorization header missing!"
                           }
          }
        }
      }
    },
